# Copy this file to .env.local and fill in the values from your Firebase
# project's web app config (Project settings > General > Your apps).
#
# These values are NOT secret - they identify which Firebase project to
# talk to, they don't grant access on their own. Access control is
# enforced by Firestore security rules instead (see docs/adr for why).
# .env.local is still gitignored anyway, just to keep per-developer config
# out of the shared repo.

VITE_FIREBASE_API_KEY=
VITE_FIREBASE_AUTH_DOMAIN=
VITE_FIREBASE_PROJECT_ID=
VITE_FIREBASE_STORAGE_BUCKET=
VITE_FIREBASE_MESSAGING_SENDER_ID=
VITE_FIREBASE_APP_ID=
